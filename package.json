{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A DeepSeek Harness-inspired agent foundation: everything is a plugin.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "build": "npm run typecheck && npm run client:build",
    "setup": "npm install && npm run client:install && npm run client:build",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
