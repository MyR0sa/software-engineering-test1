# ---- Model adapter ----
# "mock" (no key needed, deterministic demo) or "openai-compat" (DeepSeek/OpenAI/any compatible)
HARNESS_LLM_PROVIDER=mock
# OpenAI-compatible endpoint. DeepSeek: https://api.deepseek.com
HARNESS_LLM_BASE_URL=https://api.deepseek.com
HARNESS_LLM_API_KEY=
HARNESS_LLM_MODEL=deepseek-chat
HARNESS_LLM_MAX_TOKENS=4096

# ---- HTTP server ----
HARNESS_HOST=127.0.0.1
HARNESS_PORT=3080

# ---- Sandbox ----
# Workspace root: shell + filesystem tools are confined to this directory.
HARNESS_WORKSPACE=./workspace
# Shell used by the `bash` tool: bash | pwsh | cmd
HARNESS_SHELL=bash

# ---- Agent loop ----
# Hard cap on model round-trips (stream -> tool -> stream) per turn.
HARNESS_MAX_ITERATIONS=20
